{
  "name": "incident-management",
  "version": "1.0.0",
  "description": "Incident Management \u2014 CAP learning course foundation (synthetic data)",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@sap/cds": "^10.1.1",
    "@cap-js/sqlite": "^3.1.1",
    "express": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-incidents": "cds watch --open ns.incidents/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/incidents"
  ]
}
